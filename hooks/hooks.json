{
  "description": "Web safety hooks — URL pre-screening + prompt-injection scanner for web-fetching tools",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch|mcp__playwright.*|mcp__puppeteer.*|mcp__browser.*|mcp__fetch.*|mcp__markdownify.*|mcp__exa-web-search__.*|mcp__firecrawl__.*|mcp__MCP_DOCKER__.*-to-markdown|mcp__MCP_DOCKER__fetch_content|mcp__MCP_DOCKER__search|mcp__MCP_DOCKER__get_article|mcp__MCP_DOCKER__get_summary|mcp__MCP_DOCKER__get_transcript|mcp__MCP_DOCKER__get_timed_transcript|mcp__MCP_DOCKER__get_video_info|mcp__MCP_DOCKER__get_links|mcp__MCP_DOCKER__get_related_topics|mcp__MCP_DOCKER__get_sections|mcp__MCP_DOCKER__get_coordinates|mcp__MCP_DOCKER__summarize_article.*|mcp__MCP_DOCKER__extract_key_facts|mcp__MCP_DOCKER__wikipedia_.*|mcp__MCP_DOCKER__browser_.*|mcp__plugin_context7_context7__query-docs|mcp__.*(fetch|search|scrape|crawl|browse|navigate|goto|download|read_?url|url_?to|to_?markdown|get_?content|extract|http_?request|open_?url|wikipedia|transcript).*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/web-safety-approve.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/web-safety-egress.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebSearch|WebFetch|mcp__playwright.*|mcp__puppeteer.*|mcp__browser.*|mcp__fetch.*|mcp__markdownify.*|mcp__exa-web-search__.*|mcp__firecrawl__.*|mcp__MCP_DOCKER__.*-to-markdown|mcp__MCP_DOCKER__fetch_content|mcp__MCP_DOCKER__search|mcp__MCP_DOCKER__get_article|mcp__MCP_DOCKER__get_summary|mcp__MCP_DOCKER__get_transcript|mcp__MCP_DOCKER__get_timed_transcript|mcp__MCP_DOCKER__get_video_info|mcp__MCP_DOCKER__get_links|mcp__MCP_DOCKER__get_related_topics|mcp__MCP_DOCKER__get_sections|mcp__MCP_DOCKER__get_coordinates|mcp__MCP_DOCKER__summarize_article.*|mcp__MCP_DOCKER__extract_key_facts|mcp__MCP_DOCKER__wikipedia_.*|mcp__MCP_DOCKER__browser_.*|mcp__plugin_context7_context7__query-docs|mcp__.*(fetch|search|scrape|crawl|browse|navigate|goto|download|read_?url|url_?to|to_?markdown|get_?content|extract|http_?request|open_?url|wikipedia|transcript).*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/web-safety-scanner.sh",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
